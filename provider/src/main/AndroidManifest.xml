<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="kerneldroid.nightzuku.permission.API" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <queries>
        <package android:name="kerneldroid.nightzuku" />
        <package android:name="moe.shizuku.privileged.api" />
        <intent>
            <action android:name="kerneldroid.nightzuku.intent.action.REQUEST_BINDER" />
        </intent>
    </queries>

    <application tools:ignore="AllowBackup,GoogleAppIndexingWarning">
        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />
    </application>

</manifest>
